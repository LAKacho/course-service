{
  "name": "course-service/mvp",
  "description": "Local learning platform MVP with courses, sprints and task progress",
  "license": "proprietary",
  "type": "project",
  "require": {
    "php": ">=8.2",
    "ext-ctype": "*", "ext-iconv": "*", "ext-pdo": "*",
    "symfony/framework-bundle": "7.4.*", "symfony/console": "7.4.*",
    "symfony/dotenv": "7.4.*", "symfony/runtime": "7.4.*",
    "symfony/twig-bundle": "7.4.*", "symfony/form": "7.4.*",
    "symfony/validator": "7.4.*", "symfony/security-csrf": "7.4.*",
    "symfony/translation": "7.4.*", "symfony/yaml": "7.4.*",
    "doctrine/orm": "^3.3", "doctrine/doctrine-bundle": "^2.13",
    "doctrine/doctrine-migrations-bundle": "^3.4"
  },
  "require-dev": {"doctrine/doctrine-fixtures-bundle": "^4.0", "phpunit/phpunit": "^11.5", "symfony/browser-kit": "7.4.*", "symfony/css-selector": "7.4.*"},
  "autoload": {"psr-4": {"App\\DataFixtures\\": "src/Shared/Infrastructure/DataFixtures/", "App\\Entity\\": "src/Shared/Infrastructure/Compatibility/Entity/", "App\\Integration\\": "src/Shared/Integration/", "App\\": "src/", "DoctrineMigrations\\": "migrations/"}, "files": ["src/Assessment/Service/AssessmentService.php", "src/Access/AccessChecker.php", "src/Service/Import/ImportValidationException.php"]},
  "autoload-dev": {"psr-4": {"App\\Tests\\": "tests/"}},
  "config": {"allow-plugins": {"symfony/runtime": true}, "sort-packages": true},
  "scripts": {"test": "phpunit"}
}

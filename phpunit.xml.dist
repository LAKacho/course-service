<?xml version="1.0" encoding="UTF-8"?>
<phpunit bootstrap="tests/bootstrap.php" colors="true" cacheDirectory=".phpunit.cache">
    <php>
        <env name="APP_ENV" value="test" force="true"/>
        <env name="APP_DEBUG" value="1"/>
        <env name="COURSE_DEMO_USER_ID" value="demo-student" force="true"/>
        <env name="APP_SECRET" value="test-only-secret" force="true"/>
        <env name="DATABASE_URL" value="sqlite:///%kernel.project_dir%/var/test.db" force="true"/>
        <env name="KERNEL_CLASS" value="App\Kernel"/>
    </php>
    <testsuites><testsuite name="Course Service"><directory>tests</directory></testsuite></testsuites>
</phpunit>

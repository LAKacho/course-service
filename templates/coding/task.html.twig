{% extends 'coding/base.html.twig' %}
{% block title %}{{ exercise.title }}{% endblock %}
{% block body %}
<a class="back" href="{{ path('student_home') }}">← Вернуться к обучению</a>
<div class="page-title"><div><span class="eyebrow">ПРАКТИЧЕСКОЕ ЗАДАНИЕ · ВЕРСИЯ {{ exercise.version }}</span><h1>{{ exercise.title }}</h1></div><span class="runner-badge">{{ runnerAvailable ? 'Runner подключён' : 'Runner не подключён' }}</span></div>
{% if not runnerAvailable %}<div class="unavailable" role="status"><strong>Проверка временно недоступна</strong><p>Редактор и сохранение решений работают. Для запуска тестов и зачёта нужен отдельный безопасный Code Runner.</p></div>{% endif %}
<div class="workspace"><section class="panel condition"><h2>Условие</h2><p class="preserve">{{ exercise.statement }}</p><h3>Критерий сдачи</h3><p>{{ exercise.criteria }} Публичная проверка не завершает задание.</p><h3>Ограничения runner</h3><div class="limits"><span>{{ exercise.limits.timeMs }} мс</span><span>{{ exercise.limits.memoryMb }} МБ</span><span>Код ≤ 64 КиБ</span><span>Сеть отключена</span></div><p class="muted">Это требования контракта. До подключения runner исполнение отсутствует.</p><h3>Публичные примеры</h3>{% for test in exercise.publicTests %}<div class="test-case"><strong>{{ test.id }}</strong><div>Вход</div><pre>{{ test.input|json_encode(constant('JSON_UNESCAPED_UNICODE')) }}</pre><div>Ожидаемый результат</div><pre>{{ test.expected|json_encode(constant('JSON_UNESCAPED_UNICODE')) }}</pre></div>{% endfor %}</section>
<section class="panel editor-panel"><h2>Решение</h2>{% if error %}<div class="alert alert-danger">{{ error }}</div>{% endif %}
{{ form_start(form, {attr: {'data-code-form': '', 'data-starters': exercise.starters|json_encode}}) }}{{ form_errors(form) }}
<div class="language-row">{% if exercise.starters|length > 1 %}{{ form_row(form.language) }}{% else %}<div class="single-language">Язык: {{ exercise.starters|keys|first|upper }}</div><div hidden>{{ form_row(form.language) }}</div>{% endif %}<span class="muted">UTF-8 · сохраняется на сервере</span></div>
{{ form_label(form.sourceCode) }}{{ form_errors(form.sourceCode) }}<div class="code-editor"><pre class="code-highlight" aria-hidden="true"><code></code></pre>{{ form_widget(form.sourceCode) }}</div>{{ form_widget(form.versionId) }}
<p class="editor-hint">Подсветка PHP/Go · Tab — два пробела · при смене языка черновик остаётся в редакторе до перезагрузки.</p>
{% if exercise.canSubmit %}<div class="editor-actions"><button class="btn btn-primary" name="action" value="draft">Сохранить решение</button><button class="btn btn-outline-primary" name="action" value="check">Проверить</button><button class="btn btn-dark" name="action" value="submit">Сдать решение</button></div>{% else %}<p class="muted">Нет разрешения task.submit для отправки решений этого курса.</p>{% endif %}<p class="muted">{% if not runnerAvailable %}«Проверить» и «Сдать» сохранят код без запуска и без зачёта.{% else %}Проверка — только публичные тесты. Сдача — все тесты.{% endif %}</p>{{ form_end(form) }}
{% if selected %}<div class="result-panel"><h3>Сохранённая попытка</h3><span class="status status-{{ selected.status }}">{{ selected.statusLabel }}</span><p>Версия {{ selected.version }} · {{ selected.language|upper }} · {{ selected.createdAt|date('d.m.Y H:i:s') }}</p>{% if selected.score is not null %}<p>Оценка: {{ selected.score }} / 100. {{ selected.mode == 'check' ? 'Публичная проверка: задание не засчитано.' : 'Финальная сдача.' }}</p>{% endif %}{% for result in selected.publicResults %}<div class="public-result">{{ result.id }}: {{ result.passed ? 'Пройден' : 'Не пройден' }}</div>{% else %}<p class="muted">Результатов тестирования пока нет.</p>{% endfor %}{% if selected.status in ['queued','running'] %}<form method="post" action="{{ path('coding_refresh',{id:selected.id}) }}"><input type="hidden" name="_token" value="{{ csrf_token('coding_refresh_' ~ selected.id) }}"><button class="btn btn-outline-primary">Обновить результат</button></form>{% endif %}</div>{% endif %}</section></div>
<section class="panel history"><h2>История решений</h2><p class="muted">Последние 30 попыток этого задания. Старые решения сохраняются.</p><div class="history-list">{% for row in history %}<a class="history-item" href="{{ path('coding_task',{id:exercise.taskId,solution:row.id}) }}"><span>{{ row.createdAt|date('d.m.Y H:i:s') }} · {{ row.language|upper }} · v{{ row.version }}</span><span>{{ {'draft':'Сохранение','check':'Публичная проверка','submit':'Финальная сдача'}[row.mode] }}</span><strong>{{ row.statusLabel }}</strong></a>{% else %}<p>Пока нет сохранённых решений.</p>{% endfor %}</div></section>
{% endblock %}

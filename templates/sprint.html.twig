{% extends 'base.html.twig' %}{% block title %}{{ sprint.title }}{% endblock %}{% block body %}<a class="back-link" href="{{ path('course', {id:sprint.course.id}) }}">← {{ sprint.course.title }}</a><div class="page-heading"><div><div class="eyebrow">УЧЕБНЫЙ СПРИНТ</div><h1>{{ sprint.title }}</h1><p class="preserve-lines">{{ sprint.description }}</p></div><div class="heading-actions">{% if can('course.edit',sprint) %}<a class="btn btn-outline-secondary" href="{{ path('item_edit', {kind:'sprint',id:sprint.id}) }}">Редактировать</a>{% endif %}{% if can('course.edit',sprint) %}<a class="btn btn-primary" href="{{ path('item_new', {kind:'card',parentId:sprint.id}) }}">＋ Карточка</a>{% endif %}</div></div><div class="board-note">Статус карточки помогает организовать работу. Прогресс курса учитывает только выполненные задания.</div><div class="kanban">{% for label,status in statuses %}{% set columnCards = cards|filter(c => c.status == status) %}<section class="kanban-column"><h2><span class="column-dot dot-{{ status }}"></span>{{ label }} <span class="column-count">{{ columnCards|length }}</span></h2>{% for card in columnCards %}<article class="surface kanban-card"><div class="card-position">КАРТОЧКА · {{ card.position }}</div><h3><a href="{{ path('card', {id:card.id}) }}">{{ card.title }}</a></h3><p>{{ card.description|length > 140 ? card.description|slice(0,140) ~ '…' : card.description }}</p>{% if can('course.edit',card) %}<form method="post" action="{{ path('card_status', {id:card.id}) }}"><input type="hidden" name="_token" value="{{ csrf_token('card_' ~ card.id) }}"><label class="visually-hidden" for="status-{{ card.id }}">Статус {{ card.title }}</label><div class="d-flex gap-2"><select class="form-select form-select-sm" id="status-{{ card.id }}" name="status">{% for option,value in statuses %}<option value="{{ value }}" {{ value == card.status ? 'selected' : '' }}>{{ option }}</option>{% endfor %}</select><button class="btn btn-sm btn-light" aria-label="Сохранить статус {{ card.title }}">→</button></div></form>{% endif %}</article>{% else %}<div class="column-empty">Пока нет карточек</div>{% endfor %}</section>{% endfor %}</div>{% endblock %}

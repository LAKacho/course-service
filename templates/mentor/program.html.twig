{% extends 'base.html.twig' %}{% block title %}{{ learningPath.title }} · Полная программа{% endblock %}{% block body %}
<a class="back-link" href="{{ path('mentor_programs') }}">← Все программы</a><div class="eyebrow">ПОЛНАЯ СТРУКТУРА · МЕНТОР</div><div class="page-heading"><div><h1>{{ learningPath.title }}</h1><p>Вся программа: {{ outline.total }} заданий. Подписи доступности относятся к демо-ученику.</p></div><a class="btn btn-outline-secondary" href="{{ path('student_home') }}">Вид ученика</a></div>
{% for course in outline.courses %}<section class="surface editor mb-4"><h2>{{ course.title }}</h2>{% for chapter in course.chapters %}<details open class="mt-4"><summary><strong>{{ chapter.title }}</strong></summary>{% for card in chapter.cards %}<div class="ms-3 mt-3"><h3>{{ card.title }} <a class="subtle-link" href="{{ path('card', {id:card.id}) }}">Карточка →</a></h3><ul>{% for task in card.tasks %}<li class="mb-2"><strong>{{ task.title }}</strong> · {{ types[task.type] }} · {{ states[task.id]|default('Закрыто / не назначено') }}</li>{% else %}<li>Задания пока не добавлены.</li>{% endfor %}</ul></div>{% else %}<p>Карточки пока не добавлены.</p>{% endfor %}</details>{% else %}<p>Главы пока не добавлены.</p>{% endfor %}</section>{% else %}<div class="surface empty-state">Курсы пока не добавлены.</div>{% endfor %}
{% endblock %}

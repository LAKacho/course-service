{% extends 'base.html.twig' %}{% form_theme form 'bootstrap_5_layout.html.twig' %}
{% block title %}Разрешения пользователей{% endblock %}
{% block body %}<div class="eyebrow">ЛОКАЛЬНЫЙ КОНТРОЛЬ ДОСТУПА</div><h1>Разрешения пользователей</h1><p>Текущая серверная личность: <strong>{{ currentId }}</strong>. Ролей нет: каждое назначение задаёт действие и область.</p><div class="alert alert-warning">Учебный локальный режим без настоящей аутентификации. Выдача прав себе и делегирование access.manage через веб запрещены. Сменить серверную личность можно только конфигурацией локального процесса.</div>{% if error %}<div class="alert alert-danger">{{ error }}</div>{% endif %}<section class="surface editor mb-4"><h2>Выдать разрешение</h2>{{ form_start(form) }}{{ form_widget(form) }}<button class="btn btn-primary">Выдать разрешение</button>{{ form_end(form) }}</section><section class="surface editor"><h2>Назначения</h2><div class="table-responsive"><table class="table"><thead><tr><th>Пользователь</th><th>Разрешение</th><th>Область</th><th>Выдал</th><th></th></tr></thead><tbody>{% for grant in grants %}<tr><td>{{ grant.userId }}</td><td><code>{{ grant.permission }}</code></td><td>{{ grant.scopeKey }}</td><td>{{ grant.grantedBy }}</td><td>{% if grant.userId != currentId and grant.permission != 'access.manage' %}<form method="post" action="{{ path('access_revoke',{id:grant.id}) }}"><input type="hidden" name="_token" value="{{ csrf_token('access_revoke_' ~ grant.id) }}"><button class="btn btn-sm btn-outline-danger">Отозвать</button></form>{% else %}<small>Только локальный оператор</small>{% endif %}</td></tr>{% else %}<tr><td colspan="5">Назначений нет</td></tr>{% endfor %}</tbody></table></div></section>{% endblock %}

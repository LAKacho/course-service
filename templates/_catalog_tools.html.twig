<div class="catalog-tools" data-catalog-tools>
    <label class="catalog-search">
        <span aria-hidden="true">⌕</span>
        <span class="visually-hidden">Поиск в каталоге</span>
        <input type="search" data-catalog-search placeholder="Найти курс или направление…" autocomplete="off">
        <kbd>/</kbd>
    </label>
    <label class="catalog-filter"><span>Статус</span><select class="form-select" data-catalog-status>
        <option value="all">Все статусы</option>
        <option value="published">Опубликованные</option>
        <option value="draft">Черновики</option>
        <option value="archived">В архиве</option>
    </select></label>
    <span class="catalog-result" data-catalog-result aria-live="polite"></span>
</div>

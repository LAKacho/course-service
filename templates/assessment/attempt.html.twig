{% extends 'assessment/base.html.twig' %}{% block title %}{{ attempt.title }} · Тестирование{% endblock %}{% block body %}
<a class="assessment-back" href="{{ path('assessment_home') }}">← Выбор направления</a><div class="attempt-heading"><div><div class="assessment-eyebrow">ВАША ВХОДНАЯ ДИАГНОСТИКА</div><h1>{{ attempt.title }}</h1></div><span class="attempt-badge">Ответы сохраняются</span></div>
<section class="assessment-progress"><div><span>Сохранено {{ attempt.answered }} из {{ attempt.total }} ответов</span><strong>{{ attempt.percent }}%</strong></div><div class="progress" role="progressbar" aria-label="Прогресс тестирования" aria-valuenow="{{ attempt.percent }}" aria-valuemin="0" aria-valuemax="100"><div class="progress-bar" style="width:{{ attempt.percent }}%"></div></div></section>
{% if attempt.currentQuestion %}{% set question = attempt.currentQuestion %}<article class="assessment-question"><div class="question-meta">ВОПРОС {{ attempt.answered + 1 }} <span>{{ {'single_choice':'Один вариант','multiple_choice':'Несколько вариантов','true_false':'Верно или неверно','code_analysis':'Разбор кода'}[question.type] }}</span></div><h2>{{ question.text }}</h2>{% if question.codeSnippet %}<pre class="assessment-code"><code>{{ question.codeSnippet }}</code></pre>{% endif %}{{ form_start(form) }}{{ form_widget(form) }}<div class="answer-actions"><button class="assessment-button">Сохранить ответ и продолжить →</button><span>Принятый ответ нельзя изменить.</span></div>{{ form_end(form) }}</article>{% else %}<section class="assessment-panel finish-panel"><div class="assessment-eyebrow">ВСЕ ОТВЕТЫ СОХРАНЕНЫ</div><h2>Можно подвести итоги</h2><p>Результат появится после завершения попытки. До этого оценка не рассчитывается.</p><form method="post" action="{{ path('assessment_finish', {id:attempt.id}) }}"><input type="hidden" name="_token" value="{{ csrf_token('assessment_finish_' ~ attempt.id) }}"><button class="assessment-button">Завершить тестирование</button></form></section>{% endif %}
<p class="assessment-footnote">На экране только текущий вопрос. Содержимое теста не раскрывает скрытый учебный маршрут. Фрагменты кода предназначены для анализа и не выполняются сервером.</p>
{% endblock %}

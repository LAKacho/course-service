{% extends 'base.html.twig' %}{% block title %}{{ course.title }}{% endblock %}{% block body %}<a class="back-link" href="{{ path('courses') }}">← Все курсы</a><div class="page-heading"><div><span class="status status-{{ course.status }}">{{ {'draft':'Черновик','published':'Опубликован','archived':'В архиве'}[course.status] }}</span><h1 class="mt-3">{{ course.title }}</h1><p class="preserve-lines">{{ course.description }}</p></div>{% if can('course.edit',course) %}<a class="btn btn-outline-secondary" href="{{ path('item_edit', {kind:'course',id:course.id}) }}">Редактировать</a>{% endif %}</div><div class="surface progress-panel"><div class="d-flex justify-content-between"><div><h3>Ваш прогресс</h3><p>{{ progress.completed }} из {{ progress.total }} заданий выполнено</p></div><strong>{{ progress.percent }}%</strong></div><div class="progress" role="progressbar" aria-label="Прогресс курса" aria-valuenow="{{ progress.percent }}" aria-valuemin="0" aria-valuemax="100"><div class="progress-bar" style="width:{{ progress.percent }}%"></div></div></div><div class="section-heading"><div><h2>Программа курса</h2><p>Последовательно изучайте темы, объединённые в спринты.</p></div>{% if can('course.edit',course) %}<a class="btn btn-primary" href="{{ path('item_new', {kind:'sprint',parentId:course.id}) }}">＋ Добавить спринт</a>{% endif %}</div><div class="sprint-list">{% for sprint in sprints %}<article class="surface sprint-row"><span class="sprint-number">{{ '%02d'|format(loop.index) }}</span><div><h3><a href="{{ path('sprint', {id:sprint.id}) }}">{{ sprint.title }}</a></h3><p>{{ sprint.description }}</p></div><a class="row-arrow" href="{{ path('sprint', {id:sprint.id}) }}" aria-label="Открыть {{ sprint.title }}">→</a></article>{% else %}<div class="surface empty-state"><h3>Добавьте первый спринт</h3><p>Разделите программу курса на небольшие этапы.</p></div>{% endfor %}</div>{% endblock %}

{% extends 'student/base.html.twig' %}
{% block body %}
<div class="path-heading"><div><div class="eyebrow">НОВАЯ ГЛАВА НАЧИНАЕТСЯ С ВАС</div><h1>Мой путь<span class="title-star" aria-hidden="true">✦</span></h1><p>Открывайте знания. Превращайте их в опыт.</p></div><a class="quiet-button" href="#atlas">Исследовать карту <span aria-hidden="true">↗</span></a></div>
<section class="expedition-hero" aria-labelledby="current-quest-title"><div class="hero-copy"><div class="hero-kicker"><span class="beacon"></span>{{ currentQuest ? 'ВАШ СЛЕДУЮЩИЙ ШАГ' : 'ВАШЕ ПУТЕШЕСТВИЕ' }}</div>{% if currentQuest %}<span class="hero-chapter">{{ currentQuest.chapterTitle }} · {{ currentQuest.typeLabel }}</span><h2 id="current-quest-title">{{ currentQuest.title }}</h2><p>Один квест, один понятный шаг вперёд.<br>Продолжайте с того места, где остановились.</p><a class="gold-button" href="#quest-{{ currentQuest.id }}" data-quest-jump>Продолжить квест <span aria-hidden="true">→</span></a>{% else %}<h2 id="current-quest-title">{% if progress.visible %}Открытые шаги пройдены{% else %}Впереди — ваш первый шаг{% endif %}</h2><p>{% if programs.learningPaths is empty and programs.courses is empty %}Программа пока не назначена. Обратитесь к ментору.{% else %}Пока нет открытых заданий. Здесь появятся ваши следующие доступные шаги.{% endif %}</p><a class="gold-button" href="#journal">К журналу пути <span aria-hidden="true">→</span></a>{% endif %}</div><div class="hero-art" aria-hidden="true"><div class="art-orbit orbit-one"></div><div class="art-orbit orbit-two"></div><img class="hero-compass" src="/assets/path-compass.svg" alt=""><span class="art-star star-one">✧</span><span class="art-star star-two">✦</span><div class="hero-ridge ridge-far"></div><div class="hero-ridge ridge-near"></div><div class="art-route"></div></div><div class="hero-coordinate" aria-hidden="true">ОТ ЛЮБОПЫТСТВА К МАСТЕРСТВУ</div></section>
<section class="journey-stats" aria-label="Прогресс известной части"><div class="journey-stat"><span class="stat-symbol symbol-gold" aria-hidden="true">✓</span><div><strong>{{ progress.completed }}</strong><span>Пройдено шагов</span></div></div><div class="journey-stat"><span class="stat-symbol symbol-teal" aria-hidden="true">◇</span><div><strong>{{ progress.visible }}</strong><span>Известных квестов</span></div></div><div class="journey-stat progress-stat"><div class="progress-stat-heading"><span>Прогресс видимой части</span><strong>{{ progress.percentVisible }}%</strong></div><div class="path-progress" role="progressbar" aria-label="Прогресс видимых заданий" aria-valuenow="{{ progress.percentVisible }}" aria-valuemin="0" aria-valuemax="100"><span style="width:{{ progress.percentVisible }}%"></span></div><small>Выполнено {{ progress.completed }} из {{ progress.visible }} открытых заданий</small></div></section>
<div class="journey-layout"><div class="journey-primary"><section id="atlas" class="atlas-section" aria-labelledby="atlas-title"><div class="section-topline"><div><span class="eyebrow">АТЛАС ВАШЕГО ПУТИ</span><h2 id="atlas-title">Карта изучения</h2></div><span class="section-caption">Только открытая часть</span></div><div class="chapter-map">{% for chapter in chapters %}<article class="chapter-node {{ chapter.current ? 'chapter-current' : '' }} {{ chapter.knownCompleted ? 'chapter-known-done' : '' }}"><span class="chapter-pin" aria-hidden="true">{{ chapter.knownCompleted ? '✓' : '%02d'|format(loop.index) }}</span><div class="chapter-info"><span class="chapter-course">{{ chapter.courseTitle }}</span><h3>{{ chapter.title }}</h3><p>{{ chapter.completed }} из {{ chapter.visible }} известных шагов пройдено</p><span class="chapter-state">{{ chapter.current ? 'Вы сейчас здесь' : (chapter.knownCompleted ? 'Открытая часть пройдена' : 'Можно исследовать') }}</span></div><a class="chapter-arrow" href="#quest-{{ chapter.quests[0].id }}" data-quest-jump aria-label="Перейти к главе {{ chapter.title }}">↗</a></article>{% else %}<div class="map-empty"><span aria-hidden="true">◇</span><h3>Карта ждёт первого шага</h3><p>Назначенные и доступные главы появятся здесь.</p></div>{% endfor %}</div><p class="map-footnote">Отметки и прогресс относятся только к известной вам части пути.</p></section>
<section id="journal" class="journal-section" aria-labelledby="journal-title"><div class="section-topline"><div><span class="eyebrow">ОТ ЗНАНИЙ К ДЕЙСТВИЮ</span><h2 id="journal-title">Журнал квестов</h2></div></div><div class="quest-journal">{% for quest in quests %}<article id="quest-{{ quest.id }}" class="task quest-card quest-{{ quest.type }} {{ quest.state == 'completed' ? 'task-done' : '' }} {{ quest.isCurrent ? 'quest-current' : '' }}" data-quest-id="{{ quest.id }}"><details {{ quest.isCurrent ? 'open' : '' }}><summary class="quest-summary"><span class="quest-type-icon" aria-hidden="true">{{ {'reading':'▤','video':'▷','practice':'⌘','question':'?','coding':'⌨'}[quest.type] }}</span><div class="quest-summary-copy"><div class="quest-labels"><span class="type-label">{{ quest.typeLabel }}</span><span class="quest-state state-{{ quest.state }}">{{ quest.state == 'completed' ? '✓ ' : '' }}{{ quest.stateLabel }}</span></div><h3 tabindex="-1">{{ quest.title }}</h3><span class="quest-chapter">{{ quest.chapterTitle }}</span></div><span class="quest-toggle" aria-hidden="true">＋</span></summary><div class="quest-body"><p class="quest-description">{{ quest.description }}</p>{% if quest.contentUrl %}<a class="material-link" href="{{ quest.contentUrl }}" target="_blank" rel="noopener noreferrer">Открыть материал <span aria-hidden="true">↗</span></a>{% endif %}<div class="task-actions">{% if quest.state == 'available' and quest.canSubmit %}<form method="post" action="{{ path('student_start', {id:quest.id}) }}"><input type="hidden" name="_token" value="{{ csrf_token('student_start_' ~ quest.id) }}"><button class="outline-button">Начать задание</button></form>{% endif %}{% if quest.type == 'coding' %}<a class="gold-button" href="{{ path('coding_task',{id:quest.id}) }}">Открыть редактор</a>{% elseif quest.state != 'completed' and quest.canSubmit %}<form method="post" action="{{ path('student_complete', {id:quest.id}) }}"><input type="hidden" name="_token" value="{{ csrf_token('student_complete_' ~ quest.id) }}"><button class="gold-button">Отметить выполненным</button></form>{% endif %}</div></div></details></article>{% else %}<div class="journal-empty"><h3>Пока нет открытых заданий</h3><p>Дождитесь назначения программы или обратитесь к ментору.</p></div>{% endfor %}</div></section></div>
<aside class="journey-aside"><section class="side-panel"><span class="eyebrow">ВАШ КОМПАС</span><h2>Мои программы</h2>{% for item in programs.learningPaths %}<div class="program-entry"><span aria-hidden="true">◇</span><div><small>Направление</small><h3>{{ item.title }}</h3></div></div>{% endfor %}{% for item in programs.courses %}<div class="program-entry"><span aria-hidden="true">▤</span><div><small>Курс</small><h3>{{ item.title }}</h3></div></div>{% endfor %}{% if programs.learningPaths is empty and programs.courses is empty %}<p>Программа пока не назначена. Обратитесь к ментору.</p>{% endif %}</section><section class="trail-note"><span class="note-star" aria-hidden="true">✧</span><h3>Маленькие шаги.<br>Настоящие открытия.</h3><p>Читайте, пробуйте и задавайте вопросы. Путь складывается из ваших действий.</p><div class="type-legend"><span>▤ Теория</span><span>▷ Видео</span><span>⌘ Практика</span><span>? Вопрос</span></div></section></aside></div>
{% endblock %}

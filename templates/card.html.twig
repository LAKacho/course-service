{% extends 'base.html.twig' %}{% block title %}{{ card.title }}{% endblock %}{% block body %}<a class="back-link" href="{{ path('sprint', {id:card.sprint.id}) }}">← {{ card.sprint.title }}</a><div class="page-heading"><div><span class="status status-{{ card.status }}">{{ statuses|filter(v => v == card.status)|keys|first }}</span><h1 class="mt-3">{{ card.title }}</h1><p class="preserve-lines">{{ card.description }}</p></div>{% if can('course.edit',card) %}<a class="btn btn-outline-secondary" href="{{ path('item_edit', {kind:'card',id:card.id}) }}">Редактировать</a>{% endif %}</div><div class="section-heading"><div><h2>Задания <span class="heading-count">{{ tasks|length }}</span></h2><p>Выполнено {{ completed|length }} из {{ tasks|length }}. Отмечайте каждое задание отдельно.</p></div>{% if can('course.edit',card) %}<a class="btn btn-primary" href="{{ path('item_new', {kind:'task',parentId:card.id}) }}">＋ Добавить задание</a>{% endif %}</div><div class="task-list">{% for task in tasks %}{% set done = task.id in completed %}<article class="surface task {{ done ? 'task-done' : '' }}"><div class="task-marker">{{ done ? '✓' : '%02d'|format(loop.index) }}</div><div class="task-content"><span class="task-type">{{ types|filter(v => v == task.type)|keys|first }}</span><h3>{{ task.title }}</h3><p class="preserve-lines">{{ task.description }}</p>{% if task.contentUrl %}<a class="material-link" href="{{ task.contentUrl }}" target="_blank" rel="noopener noreferrer">Открыть материал ↗</a>{% endif %}<div class="task-actions">{% if task.type == 'coding' %}<span class="subtle-link">Зачёт — через Code Runner</span>{% else %}{% if can('task.submit',task) %}<form method="post" action="{{ path('task_completion', {id:task.id}) }}"><input type="hidden" name="_token" value="{{ csrf_token('task_' ~ task.id) }}"><input type="hidden" name="completed" value="{{ done ? '0' : '1' }}"><button class="btn btn-sm {{ done ? 'btn-outline-secondary' : 'btn-primary' }}">{{ done ? 'Отменить выполнение' : 'Отметить выполненным' }}</button></form>{% endif %}{% endif %}{% if can('course.edit',task) %}<a class="subtle-link" href="{{ path('coding_version_new', {id:task.id}) }}">Настроить практику кода</a>{% endif %}{% if can('course.edit',task) %}<a class="subtle-link" href="{{ path('item_edit', {kind:'task',id:task.id}) }}">Редактировать</a>{% endif %}</div></div></article>{% else %}<div class="surface empty-state"><h3>Добавьте первое задание</h3><p>Чтение, видео, практика или вопрос — выберите подходящий формат.</p></div>{% endfor %}</div>{% endblock %}

<?xml version="1.0" encoding="UTF-8"?>
<doctrine-mapping xmlns="https://www.doctrine-project.org/schemas/orm/doctrine-mapping" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="https://www.doctrine-project.org/schemas/orm/doctrine-mapping https://www.doctrine-project.org/schemas/orm/doctrine-mapping.xsd">
  <entity name="App\Mentor\Domain\Entity\Enrollment" table="enrollment">
    <id name="id" type="integer" column="id"><generator strategy="AUTO"/></id>
    <field name="userId" type="string" column="user_id" length="100"/>
    <field name="createdAt" type="datetime_immutable" column="created_at"/>
    <many-to-one field="learningPath" target-entity="App\Learning\Domain\Entity\LearningPath"><join-column name="learning_path_id" referenced-column-name="id" nullable="true"/></many-to-one>
    <many-to-one field="course" target-entity="App\Learning\Domain\Entity\Course"><join-column name="course_id" referenced-column-name="id" nullable="true"/></many-to-one>
    <unique-constraints><unique-constraint name="unique_enrollment_path" columns="user_id,learning_path_id"/></unique-constraints>
    <unique-constraints><unique-constraint name="unique_enrollment_course" columns="user_id,course_id"/></unique-constraints>
  </entity>
</doctrine-mapping>

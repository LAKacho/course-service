<?xml version="1.0" encoding="UTF-8"?>
<doctrine-mapping xmlns="https://www.doctrine-project.org/schemas/orm/doctrine-mapping" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="https://www.doctrine-project.org/schemas/orm/doctrine-mapping https://www.doctrine-project.org/schemas/orm/doctrine-mapping.xsd">
  <entity name="App\Mentor\Domain\Entity\QuestPrerequisite" table="quest_prerequisite">
    <id name="id" type="integer" column="id"><generator strategy="AUTO"/></id>
    <many-to-one field="task" target-entity="App\Learning\Domain\Entity\Task"><join-column name="task_id" referenced-column-name="id"/></many-to-one>
    <many-to-one field="requiredTask" target-entity="App\Learning\Domain\Entity\Task"><join-column name="required_task_id" referenced-column-name="id"/></many-to-one>
    <unique-constraints><unique-constraint name="unique_quest_predecessor" columns="task_id"/></unique-constraints>
  </entity>
</doctrine-mapping>

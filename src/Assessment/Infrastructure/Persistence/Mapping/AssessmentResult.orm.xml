<?xml version="1.0" encoding="UTF-8"?>
<doctrine-mapping xmlns="https://www.doctrine-project.org/schemas/orm/doctrine-mapping" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="https://www.doctrine-project.org/schemas/orm/doctrine-mapping https://www.doctrine-project.org/schemas/orm/doctrine-mapping.xsd">
  <entity name="App\Assessment\Domain\Entity\AssessmentResult" table="entry_result">
    <id name="id" type="integer"><generator strategy="AUTO"/></id>
    <one-to-one field="attempt" target-entity="App\Assessment\Domain\Entity\AssessmentAttempt"><join-column name="attempt_id" referenced-column-name="id" nullable="false"/></one-to-one>
    <field name="methodVersion" type="string" length="30"/>
    <field name="questionCount" type="integer"/>
    <field name="correctCount" type="integer"/>
    <field name="percentCorrect" type="float"/>
    <field name="weightedPercent" type="float"/>
    <field name="preliminaryLevel" type="string" length="30"/>
    <field name="confidence" type="string" length="20"/>
    <field name="difficultyBreakdown" type="json"/>
    <field name="createdAt" type="datetime_immutable"/>
  </entity>
</doctrine-mapping>

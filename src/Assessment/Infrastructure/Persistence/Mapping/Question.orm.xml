<?xml version="1.0" encoding="UTF-8"?>
<doctrine-mapping xmlns="https://www.doctrine-project.org/schemas/orm/doctrine-mapping" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="https://www.doctrine-project.org/schemas/orm/doctrine-mapping https://www.doctrine-project.org/schemas/orm/doctrine-mapping.xsd">
  <entity name="App\Assessment\Domain\Entity\Question" table="entry_question">
    <id name="id" type="integer"><generator strategy="AUTO"/></id>
    <field name="code" type="string" length="60" unique="true"/>
    <field name="version" type="integer"/>
    <field name="type" type="string" length="30"/>
    <field name="text" type="text"/>
    <field name="codeSnippet" type="text" nullable="true"/>
    <field name="language" type="string" length="15" nullable="true"/>
    <field name="difficulty" type="string" length="20"/>
    <field name="weight" type="integer"/>
    <field name="position" type="integer"/>
    <field name="correctAnswer" type="json"/>
    <field name="explanation" type="text"/>
    <field name="sourceHash" type="string" length="64"/>
    <many-to-many field="skills" target-entity="App\Assessment\Domain\Entity\Skill">
      <join-table name="entry_question_skill"><join-columns><join-column name="question_id" referenced-column-name="id"/></join-columns><inverse-join-columns><join-column name="skill_id" referenced-column-name="id"/></inverse-join-columns></join-table>
    </many-to-many>
  </entity>
</doctrine-mapping>

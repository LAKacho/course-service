<?xml version="1.0" encoding="UTF-8"?>
<doctrine-mapping xmlns="https://www.doctrine-project.org/schemas/orm/doctrine-mapping" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="https://www.doctrine-project.org/schemas/orm/doctrine-mapping https://www.doctrine-project.org/schemas/orm/doctrine-mapping.xsd">
  <entity name="App\Assessment\Domain\Entity\UserAnswer" table="entry_user_answer">
    <id name="id" type="integer"><generator strategy="AUTO"/></id>
    <many-to-one field="attempt" target-entity="App\Assessment\Domain\Entity\AssessmentAttempt"><join-column name="attempt_id" referenced-column-name="id" nullable="false"/></many-to-one>
    <many-to-one field="question" target-entity="App\Assessment\Domain\Entity\Question"><join-column name="question_id" referenced-column-name="id" nullable="true"/></many-to-one>
    <field name="questionKey" type="string" length="60"/>
    <field name="selectedOptions" type="json"/>
    <field name="answeredAt" type="datetime_immutable"/>
    <unique-constraints><unique-constraint name="unique_entry_answer" columns="attempt_id,question_key"/></unique-constraints>
  </entity>
</doctrine-mapping>

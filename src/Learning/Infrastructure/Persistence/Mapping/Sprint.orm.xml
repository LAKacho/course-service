<?xml version="1.0" encoding="UTF-8"?>
<doctrine-mapping xmlns="https://www.doctrine-project.org/schemas/orm/doctrine-mapping" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="https://www.doctrine-project.org/schemas/orm/doctrine-mapping https://www.doctrine-project.org/schemas/orm/doctrine-mapping.xsd">
  <entity name="App\Learning\Domain\Entity\Sprint" table="sprint">
    <field name="position" type="integer" column="position"/>
    <many-to-one field="course" target-entity="App\Learning\Domain\Entity\Course"><join-column name="course_id" referenced-column-name="id"/></many-to-one>
  </entity>
</doctrine-mapping>

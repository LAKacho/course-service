<?xml version="1.0" encoding="UTF-8"?>
<doctrine-mapping xmlns="https://www.doctrine-project.org/schemas/orm/doctrine-mapping" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="https://www.doctrine-project.org/schemas/orm/doctrine-mapping https://www.doctrine-project.org/schemas/orm/doctrine-mapping.xsd">
  <entity name="App\Learning\Domain\Entity\Task" table="learning_task">
    <field name="type" type="string" column="type" length="20"/>
    <field name="contentUrl" type="string" column="content_url" length="2048" nullable="true"/>
    <field name="position" type="integer" column="position"/>
    <many-to-one field="card" target-entity="App\Learning\Domain\Entity\Card"><join-column name="card_id" referenced-column-name="id"/></many-to-one>
  </entity>
</doctrine-mapping>
